# Copy this file to `.env` and fill in your Supabase project values.
# Found in the Supabase dashboard → Project Settings → API.
# The publishable key (sb_publishable_…) is a *public* client key, safe to ship
# to the browser — the database is protected by Row-Level Security, not by hiding
# this key. (It replaces the legacy "anon" key; either works with supabase-js.)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
