# Copy this file to `.env` and fill in your Supabase project values.
# Found in the Supabase dashboard → Project Settings → API.
# The anon key is a *public* client key (safe to ship to the browser) — the
# database is protected by Row-Level Security, not by hiding this key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
